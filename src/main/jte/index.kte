@import com.aiforum.web.ThreadRow
@import com.aiforum.web.PersonaView
@import com.aiforum.web.ActiveThreadRow
@import com.aiforum.web.RecentCommentRow
@param threads: List<ThreadRow>
@param personas: List<PersonaView>
@param activeThreads: List<ActiveThreadRow>
@param recentComments: List<RecentCommentRow>

@template.layout(title = "AI Forum", activeNav = "threads", content = @`
    <div class="home" data-page="home">
      <%-- Left rail. The front-page side boxes (design left rail); Members is the first occupant. The
           grid collapses to a single column below the rail breakpoint — see .home:has(.home__rail). --%>
      <aside class="home__rail" data-home-rail>
          @template.fragments.membersBox(personas = personas)
      </aside>
      <div class="home__main">
        <h1 class="home__title">Threads</h1>
        @if(threads.isEmpty())
            <div data-empty-state="no-threads">No threads yet — start one!</div>
        @else
            <div class="thread-index">
                @for(thread in threads)
                    <div class="thread-row" data-thread-id="${thread.id}" data-thread-title="${thread.title}" data-unread-count="${thread.unreadCount}">
                        <span class="thread-row__title"><a href="/threads/${thread.id}">${thread.title}</a></span>
                        @if(thread.unreadCount > 0)
                            <span class="pill">${thread.unreadCount} new</span>
                        @endif
                    </div>
                @endfor
            </div>
        @endif
        <%-- Start a thread: a plain form POST (form-urlencoded) to /threads → PRG redirect onto the new
             thread page, where the bottom composer asks the room. Split into title + body (the opening
             post's content, §2); the room is summoned from inside the thread. Body is optional. Sits
             below the list so the thread index is the first thing the page presents. --%>
        <form class="new-thread" id="new-thread" data-new-thread method="post" action="/threads">
            <span class="new-thread__label">Start a new thread</span>
            <input class="new-thread__title" type="text" name="title" required
                   placeholder="Title — what's the thread about?">
            <textarea class="new-thread__body" name="text" rows="3"
                      placeholder="Body — the details of your post (optional)"></textarea>
            <div class="new-thread__actions">
                <button class="btn" type="submit">Create ▸</button>
            </div>
        </form>
      </div>
      <%-- Right rail. The design's right-hand side boxes; Active threads is the first occupant. Drops
           below the main column on narrow screens — see .home:has(.home__rail-right). --%>
      <aside class="home__rail-right" data-home-rail-right>
          @template.fragments.recentCommentsBox(comments = recentComments)
          @template.fragments.activeThreadsBox(threads = activeThreads)
          @template.fragments.askRoomBox()
      </aside>
    </div>
`)
