@param threadId: String
@param summoning: Boolean = true
@if(summoning)
    <%-- "Summoning the room…": the create-time room summon is still routing on a worker (the dispatcher's
         "who replies" LLM call). Self-polls GET /threads/{id}/room every second; that endpoint swaps this
         poller for the drafts once they're registered (each then self-polls to settle), re-emits this
         poller while routing is still in flight, or emits nothing once a summon ends with no drafts so
         htmx stops. data-empty-state mirrors the static "waiting" state's hook. --%>
    <div data-empty-state="summoning"
         hx-get="/threads/${threadId}/room"
         hx-trigger="every 1s"
         hx-swap="outerHTML">Summoning the room…</div>
@endif
