@import com.aiforum.dto.BranchIndexEntry
@import com.aiforum.web.AuthorLabel
@param entries: List<BranchIndexEntry>
@param oob: Boolean = false

<%-- Branch index: the rail's table of contents (design "Branch index"). Each entry jumps to its
     comment via the anchor replyNode emits (id="reply-<id>"). data-rail-box / data-branch-index-entry
     are the stable hooks the acceptance suite reads — the entry hook carries the reply id so the test
     can confirm every jump target actually exists on the page.
     id="branch-index" is the OOB target: fragment responses that change the posted set re-render this
     section with oob=true, so htmx swaps the rail's copy in place by id (the section is otherwise the
     same, so the in-page render and the refresh stay identical). --%>
<section class="rail-box" id="branch-index" data-rail-box="branch-index"
         hx-swap-oob="${if (oob) "true" else null}">
    <h2 class="rail-box__title">Branch index</h2>
    @if(entries.isEmpty())
        <p class="rail-box__empty" data-branch-index-empty="true">No comments yet.</p>
    @else
        <ol class="branch-index">
            @for(entry in entries)
                <li class="branch-index__row" style="--bi-depth: ${entry.depth};">
                    <a class="branch-index__link" href="#reply-${entry.id}"
                       data-branch-index-entry="${entry.id}" data-starred="${entry.starred.toString()}">
                        <%-- Marker: a star (in the author's hue) when the owner has bookmarked this
                             comment, otherwise the plain mini-avatar dot. Both carry --mono-h so the
                             colour stays the author's either way. nav.js can flip between them live by
                             toggling data-starred on the anchor (CSS shows one or the other). --%>
                        <span class="branch-index__dot" aria-hidden="true" style="--mono-h: ${entry.hue}"></span>
                        <svg class="branch-index__star" viewBox="0 0 24 24" aria-hidden="true"
                             style="--mono-h: ${entry.hue}" fill="currentColor">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                        </svg>
                        <span class="branch-index__author">${AuthorLabel.display(entry.author)}</span>
                        <span class="branch-index__snippet">${entry.snippet}</span>
                    </a>
                </li>
            @endfor
        </ol>
    @endif
</section>
