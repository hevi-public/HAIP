@param status: Int = 500
@param message: String = "Something went wrong on the server."
<%-- The honest-failure fragment (T1.4): an uncaught exception on an htmx request lands here instead of
     the Whitelabel error PAGE, which htmx would otherwise swap whole into a fragment slot and corrupt
     the view. HtmxErrorAdvice renders this for HX-Request calls and returns it at HTTP 200 — htmx 2.0.6
     does NOT swap a non-2xx body (default responseHandling: [45].. → swap:false), so 200 is what makes
     htmx actually drop this into the slot; the real failure status rides an HX-Trigger header instead.
     A non-htmx request keeps Boot's default page (at its real error status). It's a bare fragment — no
     layout/<head> — so htmx swaps it cleanly. The stable data-error-fragment hook is what the acceptance
     suite asserts on (per the jte-spring-kotlin data-* convention), never the visible copy/CSS;
     data-error-status records the mapped status for anyone reading the DOM. role="alert" already implies
     an assertive live region, so no explicit aria-live. --%>
<div class="error-notice" role="alert"
     data-error-fragment="server"
     data-error-status="${status}">
    <span class="error-notice__icon" aria-hidden="true">⚠</span>
    <span class="error-notice__text">${message}</span>
</div>
