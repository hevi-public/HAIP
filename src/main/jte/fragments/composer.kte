@import com.aiforum.web.PersonaView
@param threadId: String
@param targetId: String
@param parentId: String?
@param scope: String
@param placement: String
@param personas: List<PersonaView>

<%-- The data-* targeting hooks and the hx-* wiring live on the SAME opening tag: the acceptance
     probe (Html.composerScope/composerAttr) reads attributes from the single tag carrying
     data-target-id, so the composer is one <form>, not a wrapper div around a form (§4). The
     class= styling hook rides along on that same tag and is ignored by the probe. --%>
<form class="composer composer--${placement}"
      data-composer="${placement}" data-target-id="${targetId}" data-scope="${scope}"
      hx-post="/threads/${threadId}/generate"
      hx-target="${if (placement == "bottom") ".reply-list" else "closest article"}"
      hx-swap="beforeend"
      <%-- Once the post succeeds, clear the editor and collapse it: the owner's message has been swapped
           in as a real comment box, so the open textarea should get out of the way. reset() empties the
           textarea for both placements; the inline composer additionally closes its <details> disclosure
           (a no-op for the persistent bottom composer, which has no enclosing <details>). --%>
      hx-on::after-request="if(event.detail.successful){this.reset();this.closest('details')?.removeAttribute('open')}">
    <div class="composer__head">
        <span class="composer__tag">${if (placement == "bottom") "↳ level 0" else "↳ inline"}</span>
        <span>${if (placement == "bottom") "New reply to the post" else "Reply in this branch"}</span>
    </div>
    @if(parentId != null)
        <input type="hidden" name="parentId" value="${parentId}">
    @endif
    <input type="hidden" name="scope" value="${scope}">
    <input type="hidden" name="triggerMode" value="SUMMON">
    <%-- The composer is the owner authoring a message: the server persists `text` as the owner's own
         node and seeds the room with it (otherwise the owner's words never appear and the personas only
         ever see a blank transcript, emitting a generic opener). --%>
    <input type="hidden" name="postAsOwner" value="true">
    <textarea name="text" placeholder="Ask the room…   write a question — anyone can answer"></textarea>
    <div class="composer__row">
        <label>who answers</label>
        <%-- Default to "Anyone": the value "auto" hands the pick to the AI dispatcher, which reads the
             topic and decides which persona(s) should chime in. Selecting a name instead summons just
             that persona. The sentinel "auto" matches GenerationService.AUTO_PERSONA. --%>
        <select name="personaIds">
            <option value="auto" selected>Anyone (the room decides)</option>
            @for(p in personas)
                <option value="${p.id}">${p.name}</option>
            @endfor
        </select>
        <%-- When "Anyone" is chosen, this scopes what the dispatcher reads to decide WHO replies:
             the whole topic (default) or just this branch. Ignored when a specific persona is named.
             Values match ScopeMode; it's independent of the hidden generation `scope` above. Inline only:
             the bottom composer is top-level (no ancestor path), so "this branch" == "whole topic" there
             — omitting it (the controller defaults routingScope to WHOLE_THREAD) keeps that placement clean. --%>
        @if(placement != "bottom")
            <label>looking at</label>
            <select name="routingScope">
                <option value="WHOLE_THREAD" selected>whole topic</option>
                <option value="BRANCH_ONLY">this branch</option>
            </select>
        @endif
        <button class="btn" type="submit">Ask ▸</button>
    </div>
</form>
