@param title: String
@param activeNav: String = ""
@param content: gg.jte.Content
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${title}</title>
    <%-- Resolve theme before first paint to avoid a light flash. We track two things on <html>:
         data-theme-mode = the user's choice (dark | light | auto), persisted in localStorage;
         data-theme      = the resolved palette (dark | light) the CSS keys off. In "auto" (the
         default) the palette follows the OS prefers-color-scheme. Runs inline (not /app.js) so it
         executes synchronously in <head> before the body renders. --%>
    <script>
        (function () {
            try {
                var mode = localStorage.getItem("theme") || "auto";
                var theme = mode === "auto"
                    ? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
                    : mode;
                var root = document.documentElement;
                root.setAttribute("data-theme-mode", mode);
                root.setAttribute("data-theme", theme);
            } catch (e) {}
        })();
    </script>
    <link rel="stylesheet" href="/app.css">
    <%-- highlight.js token colours, scoped to the [data-theme] toggle. Derived from the vendored
         highlightjs webjar themes (see hljs-theme.css header); served as a static asset, no CDN. --%>
    <link rel="stylesheet" href="/hljs-theme.css">
    <%-- htmx served from the webjar (see build.gradle.kts); version-agnostic path via webjars-locator-lite --%>
    <script src="/webjars/htmx.org/dist/htmx.min.js"></script>
    <script src="/app.js" defer></script>
    <%-- Vim-style keyboard navigation (plan_docs/keyboard-navigation.md). ES module → deferred by
         default; activates only where [data-nav-item] exists (thread page for now), no-ops elsewhere. --%>
    <script type="module" src="/nav.js"></script>
</head>
<body>
    <header class="site-header">
        <a class="site-header__brand" href="/">
            <span class="site-header__logo" aria-hidden="true">~/</span>
            <span class="site-header__wordmark">AI Forum</span>
        </a>
        <nav class="site-nav">
            <a href="/" aria-current="${if (activeNav == "threads") "page" else null}">threads</a>
            <a href="/personas" aria-current="${if (activeNav == "members") "page" else null}">members</a>
        </nav>
        <div class="theme-toggle" role="group" aria-label="Theme">
            <button type="button" class="theme-toggle__opt" data-set-theme="dark"><span aria-hidden="true">&#x263E;</span> dark</button>
            <span class="theme-toggle__sep" aria-hidden="true">/</span>
            <button type="button" class="theme-toggle__opt" data-set-theme="light"><span aria-hidden="true">&#x2600;</span> light</button>
            <span class="theme-toggle__sep" aria-hidden="true">/</span>
            <button type="button" class="theme-toggle__opt" data-set-theme="auto"><span aria-hidden="true">&#x25D1;</span> auto</button>
        </div>
    </header>
    <main class="container">
    ${content}
    </main>
    <footer class="site-footer">
        <span class="mono">~/forum</span> <span class="sep">·</span> AI Forum <span class="sep">·</span> single-user
    </footer>
</body>
</html>
