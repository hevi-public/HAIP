@param title: String
@param activeNav: String = ""
@param content: gg.jte.Content
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${title}</title>
    <%-- Resolve theme + layout before first paint to avoid a light flash / layout reflow. We track on
         <html>: data-theme-mode = the user's theme choice (dark | light | auto), persisted in
         localStorage; data-theme = the resolved palette (dark | light) the CSS keys off (in "auto",
         the default, it follows the OS); and data-rail-left / data-rail-right (open | collapsed) =
         the collapsible-sidebars state the layout CSS keys off (default open). Runs inline (not
         /app.js) so it executes synchronously in <head> before the body renders. --%>
    <script>
        (function () {
            try {
                var root = document.documentElement;
                var mode = localStorage.getItem("theme") || "auto";
                var theme = mode === "auto"
                    ? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
                    : mode;
                root.setAttribute("data-theme-mode", mode);
                root.setAttribute("data-theme", theme);
                root.setAttribute("data-rail-left", localStorage.getItem("rail-left") === "collapsed" ? "collapsed" : "open");
                root.setAttribute("data-rail-right", localStorage.getItem("rail-right") === "collapsed" ? "collapsed" : "open");
            } catch (e) {}
        })();
    </script>
    <link rel="stylesheet" href="/app.css">
    <%-- highlight.js token colours, scoped to the [data-theme] toggle. Derived from the vendored
         highlightjs webjar themes (see hljs-theme.css header); served as a static asset, no CDN. --%>
    <link rel="stylesheet" href="/hljs-theme.css">
    <%-- htmx served from the webjar (see build.gradle.kts); version-agnostic path via webjars-locator-lite --%>
    <script src="/webjars/htmx.org/dist/htmx.min.js"></script>
    <%-- Composer affordances (auto-grow, slash/@mention palettes, the note/ask toggle). ES module →
         deferred by default; imports the unit-tested composer-core decision layer. --%>
    <script type="module" src="/app.js"></script>
    <%-- Vim-style keyboard navigation (plan_docs/keyboard-navigation.md). ES module → deferred by
         default; activates only where [data-nav-item] exists (thread page for now), no-ops elsewhere. --%>
    <script type="module" src="/nav.js"></script>
    <%-- Persona create/edit prompt-staleness guard (plan_docs/persona-prompt-edit-ux.md). ES module →
         deferred; activates only where [data-persona-form] exists (members/edit pages), no-ops elsewhere. --%>
    <script type="module" src="/persona-form.js"></script>
    <%-- Click the bare header chrome to scroll to top (header is sticky on desktop, app.css). ES module
         → deferred; activates wherever [data-scroll-top] exists, no-ops elsewhere. --%>
    <script type="module" src="/header.js"></script>
    <%-- Collapsible side rails + "full screen" reading mode (plan: collapsible-sidebars). ES module →
         deferred; toggles data-rail-left/right on <html>, event-delegated so it serves the header
         group and the in-content button alike. Initial state is set by the inline script above. --%>
    <script type="module" src="/layout.js"></script>
    <%-- Honest htmx failure handling (T1.4): a global htmx:responseError / htmx:sendError listener that
         re-enables the stuck hx-disabled-elt control and surfaces a non-blocking toast, so a failed
         poll / Regenerate / +1 never leaves a spinner spinning. Pairs with HtmxErrorAdvice (the server
         error fragment). ES module, deferred; the decision layer (htmx-error-core) is unit-tested. --%>
    <script type="module" src="/htmx-error.js"></script>
</head>
<body>
    @template.fragments.siteHeader(activeNav = activeNav)
    <main class="container">
    ${content}
    </main>
    <footer class="site-footer">
        <span class="mono">~/forum</span> <span class="sep">·</span> AI Forum <span class="sep">·</span> single-user
    </footer>
</body>
</html>
