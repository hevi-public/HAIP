@import com.aiforum.dto.ReplyView
@import com.aiforum.dto.AttachmentView
@import com.aiforum.dto.BranchIndexEntry
@import com.aiforum.web.PersonaView
@import com.aiforum.web.ActiveThreadRow
@import com.aiforum.web.RecentCommentRow
@import com.aiforum.web.StarredCommentRow
@param threadId: String
@param title: String
@param body: String
@param bodyHtml: String
@param edited: Boolean = false
@param replies: List<ReplyView>
@param branchIndex: List<BranchIndexEntry>
@param waitingOnRoom: Boolean
@param summoning: Boolean
@param personas: List<PersonaView>
@param recentComments: List<RecentCommentRow>
@param activeThreads: List<ActiveThreadRow>
@param starredComments: List<StarredCommentRow>
@param opAttachments: List<AttachmentView> = java.util.Collections.emptyList()

@template.layout(title = title, activeNav = "threads", content = @`
    <div class="thread" data-thread-id="${threadId}" data-thread-title="${title}">
      <div class="thread__main">
        <%-- The OP is a nav item and editable (§7); the block lives in its own fragment so an edit can
             re-render just it. --%>
        @template.fragments.threadOp(threadId = threadId, title = title, body = body, bodyHtml = bodyHtml, edited = edited, attachments = opAttachments)
        @if(summoning && replies.isEmpty())
            <%-- The create-time summon is still routing (the dispatcher's "who replies" call runs on a
                 worker), so there are no drafts yet. Poll /threads/{id}/room until they land; htmx then
                 swaps this poller for the drafts, which each self-poll to settle. --%>
            @template.fragments.roomPoller(threadId = threadId, summoning = true)
        @else
            @if(waitingOnRoom)
                <div data-empty-state="waiting">Waiting on the room…</div>
            @endif
            @template.fragments.replyList(replies = replies, threadId = threadId, personas = personas)
        @endif
        <%-- Auto-grow: drives bounded autonomous growth (§4) down every branch that still has depth
             budget. Appends the newly-grown nodes to the reply list (same pattern as the bottom
             composer). The endpoint is synchronous; no poll needed. --%>
        <div class="thread__controls">
            <button type="button" class="btn btn--ghost"
                    hx-post="/threads/${threadId}/auto-grow"
                    hx-disabled-elt="this"
                    hx-indicator=".auto-grow-spinner"
                    hx-on::after-request="if(event.detail.successful){window.location.reload()}">Auto-grow</button>
            <span class="htmx-indicator auto-grow-spinner" aria-live="polite">
                <span class="spinner" aria-hidden="true"></span>Growing…
            </span>
        </div>
        @template.fragments.composer(placement = "bottom", targetId = threadId, parentId = null, scope = "WHOLE_THREAD", threadId = threadId, personas = personas)
      </div>
      <%-- Left rail: this thread's navigation — the branch index (a TOC/minimap of the posted nodes) and
           the context legend. Mirrors the home page's left rail, which carries navigation. Always present:
           the branch-index box shows an empty state before anything is posted, so the layout doesn't pop. --%>
      <aside class="thread__rail" data-thread-rail>
          @template.fragments.branchIndex(entries = branchIndex)
          @template.fragments.contextLegend()
      </aside>
      <%-- Right rail: forum-wide feeds — the same boxes, on the same side, as the home page's right rail,
           so "what's happening elsewhere" lives in one consistent place across pages. --%>
      <aside class="thread__rail-right" data-thread-rail-right>
          @template.fragments.starredCommentsBox(starred = starredComments)
          @template.fragments.recentCommentsBox(comments = recentComments)
          @template.fragments.activeThreadsBox(threads = activeThreads)
      </aside>
    </div>
`)
